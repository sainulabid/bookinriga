# ─────────────────────────────────────────────────────────────
# BookinRiga configuration
# Copy this file to ".env" for local development. Never commit .env.
# In production set these in Render → Environment instead.
# Leave a line blank to run that feature in DEV MODE.
# ─────────────────────────────────────────────────────────────

# Flask secret (long random string — required in production)
SECRET_KEY=please-change-this-to-a-random-string

# Database (Render PostgreSQL). Blank = local SQLite riganest.db
DATABASE_URL=

# ── Stripe (card payments) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Beds24 (catalog sync + booking export) ──
BEDS24_REFRESH_TOKEN=
# Optional: only publish these property IDs (default: all the token can read)
BEDS24_PROPERTY_IDS=

# ── Gmail (Email OTP) ──
# Gmail address + App Password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ── Resend (optional email notifications) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Google Sign-In ("Continue with Google") ──
# https://console.cloud.google.com/apis/credentials
# Redirect URI: http://127.0.0.1:5000/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (persistent image uploads) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Site ──
WHATSAPP_NUMBER=

# Admin password used only when creating the admin on a fresh database
ADMIN_PASSWORD=
